---
import { Image } from 'astro:assets';
import Parallax from '../react/Parallax';
import { projects } from '../../lib/projects';

// Grilla editorial asimétrica: cada posición tiene su propio tamaño y proporción
const layout = [
  'md:col-span-7 aspect-[4/3]',
  'md:col-span-4 md:col-start-9 md:mt-24 aspect-[3/4]',
  'md:col-span-5 aspect-[4/5]',
  'md:col-span-6 md:col-start-7 md:-mt-16 aspect-[16/11]',
  'md:col-span-4 md:col-start-2 aspect-square',
  'md:col-span-6 md:col-start-7 md:mt-20 aspect-[4/3]',
];
---
<section id="proyectos" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-32 lg:px-10">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="reveal text-xs font-semibold tracking-[0.2em] text-wood uppercase">Proyectos</p>
      <h2 class="reveal mt-4 max-w-2xl font-display text-4xl leading-[1.05] tracking-[-0.03em] sm:text-6xl" style="--i:1">Obras que conviven con su paisaje.</h2>
    </div>
  </div>
  <div class="mt-14 grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-12">
    {projects.map((p, i) => {
      const [cols, ...rest] = layout[i % layout.length].split(' aspect');
      const aspect = 'aspect' + rest.join('');
      return (
        <figure class:list={['reveal', cols]} style={`--i:${i % 2}`}>
          <div class:list={['overflow-hidden rounded-xs bg-bone', aspect]}>
            <Parallax client:visible>
              <Image src={p.image} alt={p.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
            </Parallax>
          </div>
          <figcaption class="mt-3 flex items-baseline justify-between gap-4 border-b border-forest/15 pb-3">
            <span class="font-display text-xl">{p.title}</span>
            <span class="text-xs font-semibold tracking-[0.16em] text-olive uppercase">{p.kind}</span>
          </figcaption>
        </figure>
      );
    })}
  </div>
</section>
