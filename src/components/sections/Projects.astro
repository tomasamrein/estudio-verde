---
import { getImage } from 'astro:assets';
import ProjectsGallery from '../react/ProjectsGallery';
import { projects } from '../../lib/projects';

const items = await Promise.all(
  projects.map(async (p) => {
    const img = await getImage({ src: p.image, widths: [480, 800, 1200], format: 'webp' });
    return {
      title: p.title, kind: p.kind, alt: p.alt, src: img.src, srcset: img.srcSet.attribute,
      width: Number(img.attributes.width ?? p.image.width), height: Number(img.attributes.height ?? p.image.height),
    };
  }),
);
---
<section id="proyectos" class="py-20 md:py-32 lg:pb-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <p class="reveal font-mono text-[11px] font-medium tracking-[0.22em] text-wood uppercase">Proyectos</p>
    <h2 class="reveal mt-4 max-w-2xl font-display text-4xl leading-[1.05] tracking-[-0.03em] sm:text-6xl" style="--i:1">Obras que conviven con su paisaje.</h2>
  </div>
  <div class="mt-12 lg:mt-0">
    <ProjectsGallery client:visible items={items} />
  </div>
</section>
