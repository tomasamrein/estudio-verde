---
import { getImage } from 'astro:assets';
import BeforeAfter from '../react/BeforeAfter';
import { images } from '../../lib/images';

const opts = { widths: [480, 800, 1200, 1600], format: 'webp' as const };
const [b, a] = await Promise.all([
  getImage({ src: images.reformaAntes, ...opts }),
  getImage({ src: images.reformaDespues, ...opts }),
]);
const toProps = (img: typeof b, alt: string) => ({
  src: img.src,
  srcset: img.srcSet.attribute,
  alt,
  width: Number(img.attributes.width ?? 1600),
  height: Number(img.attributes.height ?? 768),
});
---
<section id="antes-despues" class="bg-bone py-20 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="reveal font-mono text-[11px] font-medium tracking-[0.22em] text-wood uppercase">Antes y después</p>
        <h2 class="reveal mt-4 font-display text-4xl leading-[1.05] tracking-[-0.03em] sm:text-6xl" style="--i:1">Cuando la casa y el jardín se piensan juntos, el cambio se nota.</h2>
      </div>
      <p class="reveal text-lg leading-relaxed text-forest/75 lg:col-span-4 lg:col-start-9" style="--i:2">Arrastrá el divisor para comparar. Fachada recuperada, galerías abiertas y un frente que vuelve a tener verde.</p>
    </div>
    <div class="reveal mt-10" style="--i:3">
      <BeforeAfter
        client:visible
        before={toProps(b, 'Dos casas de madera deterioradas, con el frente descuidado, antes de la renovación')}
        after={toProps(a, 'Las mismas casas renovadas, pintadas, con galerías, cerco y jardín al frente')}
      />
      <p class="mt-3 text-xs text-forest/60">
        Foto de referencia: Michael E. Arth, <a class="underline" href="https://commons.wikimedia.org/wiki/File:Cracktown_to_Garden_District_DeLand_Florida_by_Michael_E._Arth.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>, CC BY-SA 4.0.
      </p>
    </div>
  </div>
</section>
