---
import { getImage } from 'astro:assets';
import BeforeAfter from '../react/BeforeAfter';
import { images } from '../../lib/images';

const opts = { widths: [480, 800, 1200, 1600], format: 'webp' as const };
const [b, a] = await Promise.all([
  getImage({ src: images.jardinAntes, ...opts }),
  getImage({ src: images.jardinDespues, ...opts }),
]);
const toProps = (img: typeof b, alt: string) => ({
  src: img.src,
  srcset: img.srcSet.attribute,
  alt,
  width: Number(img.attributes.width ?? 1600),
  height: Number(img.attributes.height ?? 1067),
});
---
<section id="antes-despues" class="bg-bone py-20 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="reveal text-xs font-semibold tracking-[0.2em] text-wood uppercase">Antes y después</p>
        <h2 class="reveal mt-4 font-display text-4xl leading-[1.05] tracking-[-0.03em] sm:text-6xl" style="--i:1">De un patio seco a un lugar para quedarse.</h2>
      </div>
      <p class="reveal text-lg leading-relaxed text-forest/75 lg:col-span-4 lg:col-start-9" style="--i:2">Arrastrá el divisor para comparar. Suelo recuperado, especies nativas y riego eficiente.</p>
    </div>
    <div class="reveal mt-10" style="--i:3">
      <BeforeAfter
        client:visible
        before={toProps(b, 'El mismo jardín antes de la intervención, con tierra seca y sin vegetación cuidada')}
        after={toProps(a, 'Jardín terminado con césped, canteros y plantas en flor')}
      />
    </div>
  </div>
</section>
