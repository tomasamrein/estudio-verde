---
import { Image } from 'astro:assets';
import { WhatsappLogoIcon, ArrowDownIcon } from '@phosphor-icons/react/dist/ssr';
import { images } from '../../lib/images';
import { waLink } from '../../lib/site';
import { buttonVariants } from '../ui/button';
---
<section id="top" data-hero class="mx-auto grid max-w-7xl gap-8 px-4 pt-8 pb-16 sm:px-6 md:min-h-[calc(100dvh-4.5rem)] lg:grid-cols-12 lg:gap-12 lg:px-10 lg:pt-12">
  <div class="flex flex-col justify-center lg:col-span-7">
    <p class="reveal mb-5 text-xs font-semibold tracking-[0.2em] text-wood uppercase">Arquitectura y paisajismo · Rosario</p>
    <h1 class="reveal font-display text-[clamp(3.6rem,15vw,9.5rem)] leading-[0.88] font-normal tracking-[-0.045em]" style="--i:1">
      Estudio<br /><em class="font-light text-olive">Verde</em>
    </h1>
    <p class="reveal mt-8 max-w-xl font-display text-2xl leading-snug sm:text-3xl" style="--i:2">
      Arquitectura y paisajismo, pensados juntos.
    </p>
    <p class="reveal mt-4 max-w-lg text-base leading-relaxed text-forest/75 sm:text-lg" style="--i:3">
      Diseñamos y construimos casas, remodelaciones, locales, jardines y terrazas con materiales nobles y respeto por el entorno. Del primer boceto a la última planta.
    </p>
    <div class="reveal mt-9 flex flex-wrap items-center gap-x-8 gap-y-4" style="--i:4">
      <a href={waLink} target="_blank" rel="noopener" class={buttonVariants({ variant: 'whatsapp', size: 'md' })}>
        <WhatsappLogoIcon size={20} weight="fill" aria-hidden="true" /> Contanos tu proyecto
      </a>
      <a href="#proyectos" class={buttonVariants({ variant: 'ghost', size: 'text' })}>
        Ver proyectos <ArrowDownIcon size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
  <div class="relative lg:col-span-5">
    <div class="reveal-clip relative h-[62vh] min-h-80 overflow-hidden rounded-xs lg:h-full">
      <Image src={images.heroCasa} alt="Casa rodeada de árboles al atardecer, con grandes ventanales" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
    </div>
    <p class="mt-3 text-xs text-forest/60">Obra y paisaje, un mismo proyecto.</p>
  </div>
</section>
