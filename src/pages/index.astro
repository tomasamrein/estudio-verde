---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import Process from '../components/sections/Process.astro';
import Transformation from '../components/sections/Transformation.astro';
import Projects from '../components/sections/Projects.astro';
import Instagram from '../components/sections/Instagram.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
import FloatingWhatsApp from '../components/sections/FloatingWhatsApp.astro';
---
<Layout>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:p-3">Saltar al contenido</a>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Philosophy />
    <Process />
    <Transformation />
    <Projects />
    <Instagram />
    <Contact />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>
